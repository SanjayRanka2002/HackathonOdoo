    <!-- Cover Page -->
    <div class="cover-page">
        <div class="cover-title">TransitOps Enterprise</div>
        <div class="cover-subtitle">Transport & Operations Management System</div>
        <hr style="width: 200px; border: 2px solid #1e3a8a; margin: 40px auto;">
        <p style="text-align: center; font-size: 14pt; color: #334155;">Complete System Specification & Documentation</p>
        <div class="cover-meta">
            <p style="text-align: center;"><strong>Version:</strong> 1.0 (Production Core)</p>
            <p style="text-align: center;"><strong>Platform Stack:</strong> Spring Boot 3.2, Thymeleaf, MySQL, Hibernate</p>
